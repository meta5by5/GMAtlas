{
  "name": "gmatlas-server",
  "version": "0.1.0",
  "description": "GMAtlas accounts, sync and licensing service (design/ACCOUNTS-SYNC-ROADMAP.md).",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "keygen": "node scripts/keygen.js",
    "secrets:local": "node scripts/secrets.js --local",
    "secrets:remote": "node scripts/secrets.js --remote",
    "secrets:production": "node scripts/secrets.js --remote --env production",
    "site": "node scripts/site.js",
    "migrate:local": "npx --yes wrangler@4 d1 migrations apply DB --local",
    "migrate:remote": "npx --yes wrangler@4 d1 migrations apply DB --remote",
    "admin:role": "node scripts/admin-role.js",
    "dev": "node scripts/site.js && npx --yes wrangler@4 dev",
    "deploy": "node scripts/site.js && npx --yes wrangler@4 deploy",
    "deploy:dev": "node scripts/site.js && npx --yes wrangler@4 deploy",
    "release:check": "node scripts/release.js --dry-run",
    "release:production": "node scripts/release.js"
  },
  "license": "UNLICENSED"
}
